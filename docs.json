{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Z-Stream",
  "theme": "almond",
  "logo": {
    "light": "https://media.brand.dev/0220da6f-e6ed-4c33-b41d-ee7443c6b557.svg",
    "dark": "https://media.brand.dev/0220da6f-e6ed-4c33-b41d-ee7443c6b557.svg"
  },
  "favicon": "https://media.brand.dev/df5d270e-765b-402f-86e9-e6bb2b3e1507.png",
  "colors": {
    "primary": "#5c5ed8",
    "light": "#3f3fa5",
    "dark": "#2f2864"
  },
  "fonts": {
    "heading": {
      "family": "Lato"
    },
    "body": {
      "family": "Lato"
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Watch Now",
      "href": "https://zstream.mov"
    }
  },
  "navigation": {
    "pages": [
      "home",
      {
        "group": "Getting Started",
        "pages": [
          "introduction",
          "supported-devices",
          "apps",
          "ads"
        ],
        "icon": "bell-exclamation",
        "expanded": true
      },
      {
        "group": "App Guides",
        "pages": [
          "apps/windows",
          "apps/android",
          "apps/ios"
        ],
        "icon": "apple-alt",
        "expanded": true
      },
      {
        "group": "FAQ",
        "pages": [
          "faq/general",
          "faq/content",
          "faq/playback",
          "faq/privacy"
        ],
        "icon": "question-circle"
      },
      {
        "group": "Help",
        "pages": [
          "help/buffering-and-quality",
          "help/missing-content",
          "help/troubleshooting"
        ],
        "icon": "hands-helping"
      },
      "help/contact"
    ]
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#ffffff",
      "dark": "#000000"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "footer": {
    "socials": {
      "website": "https://zstream.mov/"
    }
  }
}
